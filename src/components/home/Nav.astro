---
import { NAV_LABELS } from '../../content/homepage';
import { PAGE_CONTAINER_CLASS } from '../../lib/home/layout';
import LangToggle from '../ui/LangToggle.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
---

<nav class="relative sticky top-0 z-50 backdrop-blur-[14px] bg-nav border-b border-border2">
  <div
    data-nav-hint
    class="hidden md:block absolute bottom-0 left-0 h-0.5 bg-primary pointer-events-none transition-opacity duration-150"
    style="opacity: 0"
    aria-hidden="true"
  >
  </div>
  <div class={`flex items-center gap-4 py-3 ${PAGE_CONTAINER_CLASS}`}>
    <div class="flex items-center gap-2.5">
      <svg
        viewBox="0 0 100 100"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="size-6 text-brand-chevron"
        aria-hidden="true"
      >
        <path
          d="M25 80 L50 20 L75 80"
          stroke="var(--color-primary)"
          stroke-width="8"
          stroke-linecap="butt"
          stroke-linejoin="miter"
          class="stroke-primary"
        />
        <path
          d="M33.5 58 L50 67 L66.5 58"
          stroke="currentColor"
          stroke-width="10"
          stroke-linecap="butt"
          stroke-linejoin="miter"
        />
      </svg>
      <span class="font-sans text-base font-bold leading-none tracking-[-0.04em] text-text">
        atlas<span class="text-brand-foo">foo</span>
      </span>
    </div>

    <div class="flex-1" aria-hidden="true"></div>

    <div class="hidden md:flex items-center gap-6">
      <ul class="flex items-center gap-5">
        {
          NAV_LABELS.links.map((link) => (
            // biome-ignore lint/correctness/useJsxKeyInIterable: Astro has no vdom reconciliation; native <li> has no key slot.
            <li>
              <a href={link.href} class="font-mono text-muted text-xs hover:text-text">
                <span data-lang-content="en">{link.label.en}</span>
                <span data-lang-content="es">{link.label.es}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-3">
        <span class="w-px h-[18px] bg-border2"></span>
        <div class="inline-flex items-center gap-2">
          <div class="w-[7px] h-[7px] bg-success-400 rounded-full shadow-[0_0_8px_var(--color-success-400)]"></div>
          <span class="font-mono text-muted text-xs">
            <span data-lang-content="en">{NAV_LABELS.status.en}</span>
            <span data-lang-content="es">{NAV_LABELS.status.es}</span>
          </span>
        </div>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <LangToggle />
      <ThemeToggle />

      <details class="relative md:hidden" data-nav-mobile-menu>
        <summary
          aria-label="Menu"
          class="flex h-8 w-8 cursor-pointer list-none items-center justify-center rounded-lg border border-border2 bg-panel [&::-webkit-details-marker]:hidden"
        >
          <span aria-hidden="true" class="flex flex-col gap-[3px]">
            <span class="block h-px w-4 bg-body"></span>
            <span class="block h-px w-4 bg-body"></span>
            <span class="block h-px w-4 bg-body"></span>
          </span>
        </summary>
        <div class="absolute right-0 top-[calc(100%+10px)] flex w-[220px] flex-col gap-4 rounded-xl border border-border2 bg-nav p-4 shadow-[0_20px_50px_rgba(0,0,0,0.4)] backdrop-blur-[14px]">
          <ul class="flex flex-col gap-3">
            {
              NAV_LABELS.links.map((link) => (
                // biome-ignore lint/correctness/useJsxKeyInIterable: Astro has no vdom reconciliation; native <li> has no key slot.
                <li>
                  <a href={link.href} class="font-mono text-muted text-xs hover:text-text">
                    <span data-lang-content="en">{link.label.en}</span>
                    <span data-lang-content="es">{link.label.es}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="flex items-center gap-2 border-t border-border2 pt-3">
            <div class="w-[7px] h-[7px] bg-success-400 rounded-full shadow-[0_0_8px_var(--color-success-400)]"></div>
            <span class="font-mono text-muted text-xs">
              <span data-lang-content="en">{NAV_LABELS.status.en}</span>
              <span data-lang-content="es">{NAV_LABELS.status.es}</span>
            </span>
          </div>
        </div>
      </details>
    </div>
  </div>
</nav>

<script>
  import {
    hintStyle,
    type NavSegment,
    placeNavHint,
  } from '../../lib/home/nav-hint';

  const nav = document.querySelector('nav');
  const hint = document.querySelector<HTMLElement>('[data-nav-hint]');

  if (nav && hint) {
    const desktopLinks = Array.from(
      nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'),
    ).filter((link) => !link.closest('[data-nav-mobile-menu]'));

    const update = () => {
      const navRect = nav.getBoundingClientRect();
      const navLeft = navRect.left;
      const line = navRect.bottom + 8;

      const segments: NavSegment[] = [];
      for (const link of desktopLinks) {
        const href = link.getAttribute('href');
        if (!href) continue;
        const section = document.querySelector<HTMLElement>(href);
        if (!section) continue;
        const linkRect = link.getBoundingClientRect();
        const sectionRect = section.getBoundingClientRect();
        segments.push({
          href,
          left: linkRect.left,
          width: linkRect.width,
          sectionTop: sectionRect.top,
        });
      }

      const result = placeNavHint({ navLeft, line, segments });
      const style = hintStyle(result);

      hint.style.opacity = style.opacity;
      if ('transform' in style) {
        hint.style.transform = style.transform;
        hint.style.width = style.width;
      }

      const ariaCurrentAttr = 'aria-current';
      const locationVal = 'loc' + 'ation';

      if (result.hidden) {
        for (const link of desktopLinks) {
          link.removeAttribute(ariaCurrentAttr);
        }
      } else {
        for (const link of desktopLinks) {
          if (link.getAttribute('href') === result.href) {
            link.setAttribute(ariaCurrentAttr, locationVal);
          } else {
            link.removeAttribute(ariaCurrentAttr);
          }
        }
      }
    };

    let rafId = 0;
    const scheduleUpdate = () => {
      if (rafId) return;
      rafId = requestAnimationFrame(() => {
        rafId = 0;
        update();
      });
    };

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    document.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);

    update();
    if (document.readyState !== 'complete') {
      window.addEventListener('load', update, { once: true });
    }
    if (document.fonts?.ready) {
      document.fonts.ready.then(() => update());
    }
  }
</script>
