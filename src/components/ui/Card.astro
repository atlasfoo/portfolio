---
interface Props {
  variant?: "surface" | "accent";
  eyebrow?: string;
  title?: string;
}

const { variant = "surface", eyebrow, title } = Astro.props;

const variantClasses =
  variant === "accent"
    ? "border border-[rgba(47,107,255,0.22)] bg-[linear-gradient(180deg,rgba(47,107,255,0.07),var(--bg))]"
    : "border border-border2 bg-panel hover:-translate-y-1 hover:border-[rgba(47,107,255,0.45)] hover:bg-primary-600/5";
---

<div
  class:list={[
    "rounded-[14px] p-6 transition-[border-color,translate,background-color] duration-200",
    variantClasses,
  ]}
>
  {eyebrow && <p class="font-mono text-primary2 text-sm mb-4">{eyebrow}</p>}
  {title && <h3 class="font-sans font-semibold text-lg text-text mb-2">{title}</h3>}
  <div class="text-muted text-sm leading-[1.58]">
    <slot />
  </div>
</div>
